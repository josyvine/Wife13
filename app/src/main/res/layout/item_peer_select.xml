<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="100dp"
    android:layout_height="124dp"
    android:layout_margin="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/editorial_border"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/editorial_background"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp">

        <!-- Dynamic Peer Avatar Holder -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/editorial_border"
            app:strokeWidth="1dp"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="@color/editorial_surface">

            <ImageView
                android:id="@+id/ivPeerAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@android:drawable/sym_def_app_icon"
                android:contentDescription="Peer Avatar Picture" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Custom Peer Display Name -->
        <TextView
            android:id="@+id/tvPeerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mesh Peer"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/editorial_primary_dark"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_marginBottom="4dp" />

        <!-- Checkbox indicating target selection state -->
        <CheckBox
            android:id="@+id/cbPeerSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:buttonTint="@color/editorial_accent"
            android:clickable="false"
            android:focusable="false" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>